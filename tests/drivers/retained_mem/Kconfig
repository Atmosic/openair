# Test-specific configuration for retained memory driver tests

source "Kconfig.zephyr"

config RETAINED_MEM_TEST_HIBERNATION_DURATION_MS
	int "Hibernation duration for tests in milliseconds"
	default 2 if ATM_IS_FOR_SIM
	default 2000
	help
	  Duration in milliseconds for hibernation during tests.
	  Longer durations provide more realistic testing but increase
	  test execution time.

config RETAINED_MEM_TEST_LOG_LEVEL
	int "Log level for retained memory tests"
	default 4
	range 0 4
	help
	  Sets the log level for retained memory test module.
	  Levels: 0=OFF, 1=ERR, 2=WRN, 3=INF, 4=DBG
	  Use 4 (DBG) for detailed debug output including data patterns,
	  checksums, and hibernation status. Use 3 (INF) for normal output.

config RETAINED_MEM_TEST_ATM_BACKEND_INIT
	bool "Exercise Atmosic retained_mem_backend_init() for coverage"
	default y
	depends on COVERAGE
	depends on DT_HAS_ATMOSIC_RETAINED_HIB_ENABLED
	help
	  When enabled, the test includes the Atmosic retained memory driver's
	  private backend header to call cold-boot initialization for code
	  coverage.
