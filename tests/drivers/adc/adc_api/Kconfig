config TEST_ATM_ADC_API
	bool
	default y if ADC_ATM34 || ADC_ATMx3 || ADC_ATMx2
	select ATM_ADC_TEST_API
	help
	    Includes test_atm_adc_api.c for testing

config TEST_RAW_SAMPLE_BIT_MASK
	hex "Bit mask applied to each raw GADC sample before bit assembly"
	default 0x4 if ADC_ATMx2
	default 0x2
	depends on TEST_ATM_ADC_API
	help
	    Selects which bit(s) of each raw 16-bit GADC sample are extracted
	    during the assembly loop.

config TEST_CAPTURE_RATE_MAX_HZ
	int "Fastest capture rate the GADC can be programmed to"
	default 111111 if ADC_ATMx3 || ADC_ATMx2
	default 500000
	depends on TEST_ATM_ADC_API
	help
	    ATM34 decimates by OSR alone (8MHz / 16). ATMx3 and ATMx2 fold the
	    decimation into hardware averaging, so a conversion costs two
	    datapath cycles on top of the averaged samples (2MHz / 18).

config TEST_CAPTURE_RATE_MIN_HZ
	int "Slowest capture rate the GADC can be programmed to"
	default 972 if ADC_ATMx3
	default 1734 if ADC_ATMx2
	default 7812
	depends on TEST_ATM_ADC_API
	help
	    Must be exactly achievable: the rate selector never rounds up, so a
	    request below the floor is rejected rather than clamped.

config TEST_CAPTURE_BURST_RATE_HZ
	int "Capture rate the polled drain is asked to sustain"
	default 50000 if ADC_ATMx3 || ADC_ATMx2
	default 125000
	depends on TEST_ATM_ADC_API
	help
	    Below the rate selector's ceiling on purpose: the burst test asks
	    whether the polled drain keeps up, not whether the converter can be
	    programmed faster than it can be read.

config ADC_32_BITS_DATA
	default y

source "$(ZEPHYR_BASE)/tests/drivers/adc/adc_api/Kconfig"
