#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	buzzer: buzzer {
		compatible = "atmosic,atm3x-pwm-buzzer";
		pwms = <&pwm3 3 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
		min-frequency = <123>;
		max-frequency = <8000000>;
	};
};

&pwm3 {
	status = "okay";
};
