&soc_off {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <2000000>;
	/delete-property/ hw-flow-control;
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	/delete-property/ hw-flow-control;
};
