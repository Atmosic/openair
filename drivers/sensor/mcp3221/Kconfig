config MCP3221
	bool "MCP3221 i2c 12-bit ADC"
	default y
	depends on DT_HAS_ATMOSIC_MCP3221_SENSOR_ENABLED
	select I2C
	help
	  Enable driver for MCP3221 i2c ADC.
