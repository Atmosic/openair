config GPIO_ATM
	bool "Atmosic GPIO driver with automatic pinmux"
	default y
	depends on DT_HAS_ATMOSIC_ATM_GPIO_ENABLED
	help
	  Enable the Atmosic GPIO driver which extends the ARM CMSDK AHB
	  GPIO driver with automatic pin multiplexing configuration.

	  This driver automatically calls PIN_SELECT() to configure pins
	  as GPIO when gpio_pin_configure() is called, eliminating the
	  need for manual pinmux setup in application code.

	  This is particularly useful for pins like P0 and P1 which
	  default to SWD function and need to be explicitly muxed to
	  GPIO before use.

	  Note: This driver reuses functions from the ARM CMSDK AHB GPIO
	  driver (gpio_cmsdk_ahb.c) which is compiled as part of this driver.

if GPIO_ATM

config GPIO_ATM_ALLOW_DISCONNECT
	bool "Allow GPIO_DISCONNECTED to clear pull-up/pull-down and input enable"
	help
	  The ARM CMSDK AHB GPIO driver (gpio_cmsdk_ahb.c), which this driver
	  reuses, normally rejects gpio_pin_configure() calls with
	  -ENOTSUP when neither GPIO_INPUT nor GPIO_OUTPUT is set (i.e.
	  GPIO_DISCONNECTED). This means callers relying on
	  GPIO_DISCONNECTED to tear down a pin's input enable and
	  pull-up/pull-down configuration silently fail, leaving those
	  registers latched.

	  Enable this option to allow GPIO_DISCONNECTED requests to fall
	  through and actually clear the outenable/inenable/pullup_enable/
	  pulldown_enable registers for the pin, instead of returning
	  -ENOTSUP.

	  Default is 'n' to preserve existing behavior; enable explicitly
	  in applications that depend on GPIO_DISCONNECTED clearing pin
	  state.

config GPIO_ATM_RESET_GPIOS_ON_WARM_RESET
	bool "Reset GPIO state on warm reset"
	default y if MCUBOOT
	default y if !BOOTLOADER_MCUBOOT && (ATM_NO_TZ || TRUSTED_EXECUTION_NONSECURE)
	select ATM_RESET
	help
	  This option resets GPIO pin states during either due to warm
	  reset or watchdog reset

endif # GPIO_ATM
