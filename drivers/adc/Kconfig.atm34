# ADC configuration options

# Copyright (c) 2023-2026 Atmosic
# SPDX-License-Identifier: LicenseRef-Atmosic

config ADC_ATM34
	bool "Atmosic ATM34 ADC driver"
	default y
	depends on DT_HAS_ATMOSIC_ATM34_ADC_ENABLED
	help
	  This option enables the ADC driver for ATM34
	  family of processors.
	  Support 16-bit resolution.
	  Support 11 channels: ch1~ch11.

if ADC_ATM34

config CBPRINTF_FP_SUPPORT
	default y
	bool "Enable floating point support"

config ADC_ASYNC
	default y
	bool "Enable asynchronous mode"

config ADC_CAL_REFRESH_INTERVAL
	int "Refresh interval (in ms) for gain extensions"
	default 5000
	help
	    Schedules calibration measurements to update the offset_comp* registers

config ATM_ADC_TEST_API
	bool "Enable ADC test API (TEST ONLY)"
	help
	    Exposes atm_adc_test_raw_samples() which reads raw GADC samples
	    from a single channel via direct register access, for hardware
	    bring-up and validation. Bypasses the Zephyr ADC subsystem and
	    calibration; not for production use.

config ATM_ADC_CAL_RELOAD
	bool
	default y
	help
	    The driver exposes atm_adc_reload_cal() to re-read the GADC
	    calibration tag after the active secure journal changes.

config ATM_ADC_CAL_TEST_HOOKS
	bool "Enable GADC calibration reload test hooks (TEST ONLY)"
	depends on ATM_ADC_CAL_RELOAD && ATM_ADC_TEST_API
	default y if ZTEST
	help
	    Exposes atm_adc_test_invalidate_cal() and
	    atm_adc_test_set_cal_missing() so tests can verify that
	    atm_adc_reload_cal() re-reads the secure journal. Not for
	    production use.

endif
