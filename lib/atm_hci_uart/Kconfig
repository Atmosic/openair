config ATM_HCI_UART
	bool "Atmosic HCI UART module"
	default y if ATM_VENDOR

if ATM_HCI_UART

module = ATM_HCI_UART
module-str = atm_hci_uart
source "subsys/logging/Kconfig.template.log_config"

config ATM_VENDOR_TX_STACK_SIZE
	int "ATM hci uart tx thread stack size"
	default 2048 if COVERAGE
	default 1792

config ATM_VENDOR_RX_STACK_SIZE
	int "ATM hci uart rx thread stack size"
	default 2048 if COVERAGE
	default 1792

choice
	prompt "Atmosic HCI UART DEVICE"
	default ATM_HCI_UART0_DEVICE

config ATM_HCI_UART0_DEVICE
	bool "Use uart0 as HCI uart"

config ATM_HCI_UART1_DEVICE
	bool "Use uart1 as HCI uart"

endchoice

config ATM_HCI_RESET_RX_DC_CAL
	bool "Trigger RX DC offset calibration on HCI reset complete"
	depends on ATM_ATLC
	select ATM_RADIO_HAL_MGR
	select ATM_RADIO_CAL_DEMAND
	select VND_BYPASS_RX_DC_CAL
	help
	  When enabled, a one-shot RX DC offset calibration is triggered when an
	  HCI_reset command complete event is detected. A vendor command
	  (OCF=0x15, OGF=0xF8) is provided to bypass this behaviour.

endif # ATM_HCI_UART
