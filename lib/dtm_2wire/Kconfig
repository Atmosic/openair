menuconfig DTM_2WIRE
	bool "DTM 2-wire Direct Test Mode support"
	depends on BT
	help
	  Enable DTM 2-wire Direct Test Mode support. This provides
	  a lightweight 2-wire UART interface for Bluetooth LE radio
	  testing using the DTM protocol specified in Bluetooth Core
	  Specification Volume 6, Part F.

if DTM_2WIRE

module = DTM_2WIRE
module-str = DTM-2-wire
source "subsys/logging/Kconfig.template.log_config"

config DTM_2WIRE_E2E
    bool "Implement full end-to-end DTM processing"
    default y
    help
      The application can disable this option to utilize a minimum
      set of manager and HCI bridge software interfaces to process
      DTM messages.

config DTM_2WIRE_USER_DATA_LEN_PROPS
    bool "Use user provided data len properties"
    default n
    help
      The application can set this to use static default properties.
      This is useful where a link layer may not implement the
      HCI_LE_READ_MAX_DATA_LEN opcode.

choice DTM_2WIRE_RX_TESTING
    prompt "RX Testing support"
    default DTM_2WIRE_RX_TESTING_ENABLED
    help
      Select how the library handles DTM Receiver Test commands.

config DTM_2WIRE_RX_TESTING_ENABLED
    bool "Enabled"
    help
      Full RX testing. The library forwards the Receiver Test command
      to the controller via HCI and reports the actual packet count on
      test end. Use in applications where the BLE controller RX path
      is available.

config DTM_2WIRE_RX_TESTING_DISABLED
    bool "Disabled"
    help
      No RX testing. Receiver Test commands are rejected. Use in
      transmit-only applications.

config DTM_2WIRE_RX_TESTING_SIMULATED
    bool "Simulated"
    help
      Simulated RX testing. The library accepts Receiver Test commands
      and returns success, but never issues an HCI command to the
      controller. When the test ends, the library always reports
      0 packets received. Use when the controller does not support RX
      but the test host expects RX commands to succeed.

endchoice

config DTM_2WIRE_EXT
    bool "Support extended PHY"
    default y
    help
      Support for extended testing can be disabled and fall back
      to legacy 1M PHY.

config DTM_2WIRE_RESET_RX_DC_CAL
    bool "Trigger RX DC offset calibration on DTM reset complete"
    depends on ATM_ATLC
    select ATM_RADIO_HAL_MGR
    select ATM_RADIO_CAL_DEMAND
    help
      When enabled, a one-shot RX DC offset calibration is triggered when a DTM
      reset command completes successfully (DTM_CTRL_RESET). A vendor-specific
      DTM setup control command (DTM_CTRL_BYPASS_RX_DC_CAL, ctrl=0x3F) is
      provided to bypass this behaviour.

if DTM_2WIRE_USER_DATA_LEN_PROPS

# See:  Vol 6, Part B, section 4.5.10

config DTM_2WIRE_USER_DATA_LEN_MAX_TX_OCTETS
    int "Max TX Octets"
    default 27

config DTM_2WIRE_USER_DATA_LEN_MAX_TX_TIME
    int "Max TX Time"
    default 328

config DTM_2WIRE_USER_DATA_LEN_MAX_RX_OCTETS
    int "Max RX Octets"
    default 27

config DTM_2WIRE_USER_DATA_LEN_MAX_RX_TIME
    int "Max RX Time"
    default 328

endif # DTM_2WIRE_USER_DATA_LEN_PROPS

endif # DTM_2WIRE
