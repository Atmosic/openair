config ATM_AT_CMD
	bool "Atmosic AT command core and parser library"

if ATM_AT_CMD

config AT_CMD_PREFIX
	string "AT command prefix"
	default "AT+"
	help
	  The prefix string matched byte-by-byte (case-insensitive) to identify
	  the start of an AT command. Change this only if your protocol uses a
	  different command prefix (e.g. "AT#"). Used by all transports (UART,
	  GATT).

config ATM_AT_CMD_UART_TRANSPORT
	bool "AT command UART transport"
	default y
	help
	  Enable the UART transport layer for AT commands. This provides a generic
	  UART driver interface for AT command transport.

if ATM_AT_CMD_UART_TRANSPORT

config AT_CMD_UART_RX_BUF_SIZE
	int "UART RX buffer size"
	default 2048
	range 256 4096
	help
	  Size of the receive buffer used by the UART transport to accumulate
	  incoming AT command bytes. Must be large enough to hold the longest
	  expected command including the header prefix, command name, '=', and
	  all parameters.

endif # ATM_AT_CMD_UART_TRANSPORT

config AT_CMD_XFER_MAX_NUM
	int "Maximum number of AT command transport channels"
	default 3
	range 1 5
	help
	  Maximum number of simultaneous AT command transport channels (e.g.
	  UART, GATT, custom).  Each channel occupies a small static slot
	  (xfer + resp function pointers).  Increase this when multiple
	  transports or test suites allocate channels concurrently.

config AT_CMD_RESP_LEN
	int "AT command response buffer size"
	default 256
	help
	  Maximum size of the underlying AT command response buffer. This defines
	  the maximum length of any fully formatted AT command response string
	  (including prefix, postfix, and all parameters).

config AT_CMD_RSP_FMT_MAX_LEN
	int "AT command response format string maximum length"
	default 64
	help
	  Maximum length of an AT command response format string (e.g., "B,A(0~32)").
	  This is used internally by the AT command parser when processing responses.

module = AT_CMD
module-str = at_cmd
source "subsys/logging/Kconfig.template.log_config"

endif # ATM_AT_CMD
