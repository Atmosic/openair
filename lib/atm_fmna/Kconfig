config ATM_FMNA
	bool "Atmosic Apple FindMy Network service"

config HEAP_MEM_POOL_ADD_SIZE_ATM_FMNA
	int "Heap memory pool size for FMNA service"
	default 2048
	depends on ATM_FMNA
	help
	  Additional heap memory pool size required by Apple FindMy Network service.
	  This includes scheduler work items, GATT indications, and UARP buffers.

config ATM_FMNA_LIB
	bool "Atmosic FMNA static library"
	default y if ATM_FMNA
	depends on ATM_FMNA
	select APP_WORK_Q
	select ATM_UECC
	select ATM_UECC_VLI_API
	select ATM_UECC_SUPPORT_POINT_ADD
	select ATM_UECC_SUPPORTS_SECP224R1
	select ATM_UECC_SUPPORTS_SECP256R1
	select ENTROPY_ATM_TRNG
	select ENTROPY_GENERATOR
	select MBEDTLS
	select MBEDTLS_PSA_CRYPTO_C
	select PSA_WANT_KEY_TYPE_AES
	select PSA_WANT_ALG_GCM
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_ALG_HMAC
	select PSA_WANT_KEY_TYPE_HMAC

config ATM_FMNA_LIB_DEBUG
	bool "Atmosic FMNA static library enable debug log"
	default y if ATM_FMNA_LIB
	depends on ATM_FMNA_LIB

config USE_UARP
	bool "OTA with Apple UARP"
	select STREAM_FLASH
	select IMG_MANAGER
	select ATM_VENDOR_DFU
	depends on BOOTLOADER_MCUBOOT
	help
	  Enable Apple UARP-based OTA. Routes all incoming firmware bytes
	  through the shared atm_vendor_dfu helper, which transparently
	  handles single-image and dual-image (ATMX-tagged) MCUboot layouts.
