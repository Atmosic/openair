if SOC_SERIES_ATM5

config ATM_LL_HEAP_SIZE
	int "LL heap size"
	default 40388 if SOC_ATM5XXX_2 && ATMWSTK_PD50
	default 60388 if SOC_ATM5XXX_2 && ATMWSTK_CPD200
	default 80388 if SOC_ATM5XXX_2
	default 80572

config SYS_CLOCK_HW_CYCLES_PER_SEC
	int
	default 16000000 if $(dt_nodelabel_bool_prop,systick,external-clock-source)
	default 32000000

config NUM_IRQS
	int
	default 128

config HW_STACK_PROTECTION
	default y

config CORTEX_M_NULL_POINTER_EXCEPTION_PAGE_SIZE
	hex "Size of paged unmapped to implement null pointer detection"
	default $(dt_nodelabel_reg_size_hex,rom_null_page)
	depends on $(dt_nodelabel_exists,rom_null_page)
	depends on NULL_POINTER_EXCEPTION_DETECTION_MPU

config ATM_ANTENNA_RAM_ONLY_FOR_PM
	default y

config ATM_ENA_BLE_CS_MANDATORY_TIMING_ONLY
	default y

endif # SOC_SERIES_ATM5
