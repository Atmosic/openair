config SOC_SERIES_ATM5
	select ARM
	select CPU_CORTEX_M33
	select CPU_HAS_ARM_SAU
	select CPU_HAS_ARM_MPU
	select CPU_HAS_FPU
	select FPU
	select ARMV8_M_DSP
	select CPU_HAS_TEE
	select HAS_PM
	select HAS_POWEROFF if PM && $(dt_path_enabled,/power-states/soc_off)
	select SOC_ATM_SYSTICK_COUNTFLAG_WORKAROUND
	help
	  Enable support for ATM5 series
