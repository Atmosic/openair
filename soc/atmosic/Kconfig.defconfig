# Source MCUmgr DFU defconfig early to provide automatic OTA/DFU defaults
source "$(ZEPHYR_OPENAIR_MODULE_DIR)/subsys/mcumgr_dfu/Kconfig.defconfig"

if SOC_FAMILY_ATM

rsource "*/Kconfig.defconfig"

config SOC_FAMILY_ATM
	select HAS_SEGGER_RTT if ZEPHYR_SEGGER_MODULE
	select HAS_COVERAGE_SUPPORT

config AUTO_TEST
	bool "Enable Auto Test"
	default n

config PM
	bool "Enable Power Management"
	default y

# Suspend-to-RAM is implemented by PSEQ retention mode
config PM_S2RAM
	default n

# Set the discardable HCI event buffer size to 255 bytes by default when both
# Extended Advertising and Observer role are enabled. This value matches the HCI
# Event packet with up to 255 bytes of data defined in the BLE specification for
# Extended Advertising Report events, which are received in Observer role.
config BT_BUF_EVT_DISCARDABLE_SIZE
	default 255 if BT_EXT_ADV && BT_OBSERVER

config BT_BUF_ACL_RX_SIZE
	default 255 if BT_HCI_RAW

config BT_BUF_CMD_TX_SIZE
	default 255 if BT_HCI_RAW

if ENTROPY_ATM_TRNG

# NOTE: To get the best performance from the TRNG, a suitable
# PRNG should be used for random and cryptographically secure
# random number generators.  TRNG only provides a source of
# entropy for these generators.
# Avoid the use of ENTROPY_DEVICE_RANDOM_GENERATOR or
# HARDWARE_DEVICE_CS_GENERATOR option that acquire numbers
# directly from the entropy generator.

# default the RNG to a PRNG seeded by the ATM TRNG
choice RNG_GENERATOR_CHOICE
	default XOSHIRO_RANDOM_GENERATOR
endchoice

# ATM TRNG HW should be used as an entropy source for a secure PRNG
# implementation.  Route it through the PSA Crypto CSPRNG.
choice CSPRNG_GENERATOR_CHOICE
	depends on PSA_CRYPTO
	default PSA_CSPRNG_GENERATOR
endchoice

config BT_RX_STACK_SIZE
	int
	default 1856 if ATM_BLE && ATM_AES_HW
	default 1792
	depends on MBEDTLS
	depends on BT

config MAIN_STACK_SIZE
	int
	default 2560 if COVERAGE_GCOV
	default 2048 if ATM_BLE && ATM_AES_HW
	default 1792 if MBEDTLS

config BT_LONG_WQ_STACK_SIZE
	default 2304

config ZTEST_STACK_SIZE
	int
	default 2048 if COVERAGE_GCOV
	default 1792 if MBEDTLS

config THREAD_NAME
	bool
	default y if COVERAGE_GCOV

config OVERRIDE_FRAME_POINTER_DEFAULT
	bool
	default y if COVERAGE_GCOV

config OMIT_FRAME_POINTER
	bool
	default y if COVERAGE_GCOV

endif # ENTROPY_ATM_TRNG

config HEAP_MEM_POOL_ADD_SIZE_PSA_CRYPTO
	int "Additional heap memory pool size for PSA Crypto"
	default 1536 if MBEDTLS_PSA_CRYPTO_C && !MBEDTLS_ENABLE_HEAP
	default 0
	help
	  PSA Crypto allocates a persistent global driver context (and a
	  CTR_DRBG state when MBEDTLS_PSA_CRYPTO_LEGACY_RNG is selected) plus
	  per-call cipher / key-derivation operation contexts from the system
	  k_heap whenever MBEDTLS_ENABLE_HEAP is disabled. Reserve headroom
	  here so PSA users (FMNA, STF, ...) do not starve other consumers.
	  Sized for MBEDTLS_PSA_STATIC_KEY_SLOTS=y; raise this if dynamic
	  key slots are re-enabled.

if BOOTLOADER_MCUBOOT

choice MCUBOOT_BOOTLOADER_MODE
	default MCUBOOT_BOOTLOADER_MODE_SWAP_USING_OFFSET
endchoice

endif # BOOTLOADER_MCUBOOT

if MCUBOOT

config BOOT_ECDSA_MICRO_ECC
	bool "Use Micro ECC to accelerate PSA ecdsa"
	depends on BOOT_ECDSA_PSA
	default y if BOOT_ECDSA_PSA
	select ATM_UECC_PSA
	select ATM_UECC_PSA_NO_FALLBACK
	select ATM_UECC_VLI_API
	select OVERRIDE_FRAME_POINTER_DEFAULT
	select OMIT_FRAME_POINTER
	select PSA_CRYPTO # Needed by ATM_UECC_PSA

config BOOT_SHA2_ATM
	bool "Use Atmosic SHA acceleration"
	depends on !USERSPACE
	depends on PSA_WANT_ALG_SHA_256
	select ATM_SHA2_HW

endif # MCUBOOT

endif # SOC_FAMILY_ATM
