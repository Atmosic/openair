config ATM_DMA
	bool "Atmosic DMA module"
	depends on SOC_FAMILY_ATM
	default y if TRUSTED_EXECUTION_NONSECURE || MCUBOOT || ATM_NO_SPE

if ATM_DMA

config ATM_DMA_MINIMAL
	bool "Minimal DMA driver"
	default y if MCUBOOT
	default y if !BT && !ATM_ATLC && !ENTROPY_ATM_TRNG && !I2S_ATM && !PWM_ATM_FIFO

config ATM_DMA_FIFO_RX
	bool "Enable RX DMA"

config ATM_DMA_RELOC_SRAM
	bool
	help
	  Relocate performance and power critical functions to SRAM, while
	  still satisfying early init requirements.

config ATM_DMA_USE_FOR_MEMCPY
	bool
	default y
	depends on !USERSPACE
	help
	  Use DMA engine for libc memcpy().

config ATM_DMA_USE_FOR_MEMSET
	bool
	default y
	depends on !USERSPACE
	help
	  Use DMA engine for libc memset().

endif # ATM_DMA
