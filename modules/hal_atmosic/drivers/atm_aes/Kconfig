config ATM_AES
	bool "Atmosic AES module"
	default y if ATM_BLE || ATM_AES_HW

config ATM_AES_SUPPORTS_ECB_128
	bool

config ATM_AES_SUPPORTS_ECB_256
	bool

config ATM_AES_SUPPORTS_CTR_128
	bool

config ATM_AES_SUPPORTS_DECRYPT
	bool

config ATM_AES_ATM_CORE
	bool

choice ATM_AES_IMPL
	prompt "Atmosic AES default implementation"
	default ATM_AES_DEFAULT if ATM_AES
	default ATM_AES_NONE if !ATM_AES

config ATM_AES_DEFAULT
	bool "Atmosic AES default implementation"
	select ATM_AES_SUPPORTS_ECB_128
	select ATM_AES_SUPPORTS_ECB_256
	select ATM_AES_SUPPORTS_CTR_128
	select ATM_AES_SUPPORTS_DECRYPT
	select ATM_AES_ATM_CORE

config ATM_AES_IMPL_ECB_CTR_128_NO_DECRYPT
	bool "Atmosic AES 128-bit ECB and CTR encrypt only"
	select ATM_AES_SUPPORTS_ECB_128
	select ATM_AES_SUPPORTS_CTR_128
	select ATM_AES_ATM_CORE

config ATM_AES_NONE
	bool "No Atmosic AES implementation"

endchoice

config ATM_AES_HW
	bool "Hardware accelerator for AES"
	default y
	depends on MBEDTLS_CIPHER_AES_ENABLED && !USERSPACE
	select MBEDTLS_USER_CONFIG_ENABLE

if ATM_AES

config ATM_AES_CAN_REVERSE_BYTES
	bool "Atmosic AES can reverse byte order"
	default n if SOC_SERIES_ATM33
	default y

endif # ATM_AES
