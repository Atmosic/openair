config ATM_NV_MEM_ROM_PROT
	bool "Atmosic ROM protection"
	depends on DT_HAS_ATMOSIC_SEC_NV_MEM_ROM_PROT_ENABLED
	default y
	help
	  This option enables the Atmosic ROM protection
	  driver

config ATM_NV_MEM_RRAM_PROT
	bool "Atmosic RRAM protection"
	depends on DT_HAS_ATMOSIC_SEC_NV_MEM_RRAM_PROT_ENABLED
	default y
	help
	  This option enables the Atmosic RRAM read/write
	  protection driver.

config ATM_NV_MEM_FLASH_PROT
	bool "Atmosic FLASH protection"
	depends on DT_HAS_ATMOSIC_SEC_NV_MEM_FLASH_PROT_ENABLED
	help
	  This option enables the Atmosic Flash read/write
	  protection driver.
