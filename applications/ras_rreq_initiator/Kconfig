source "Kconfig.zephyr"

config BTN_DISABLE_CS_PROC
	bool "Enable/Disable CS Procedure with Button"

config AUTO_ENABLE_CS_FOR_UNSPECIFIED_ABORT
	bool "Auto Enable CS Procedure as abort with unspecified reason"
	default y

config CS_PROC_ANT_CFG_SEL
	int "CS Tone Antenna Selection 0:1_1 1:2_1 2:3_1 3:4_1 4:1-2 5:1_3 6:1_4 7:2_2"
	range 0 7
	default 7

config TX_POWER_DELTA
	int "Transmit Power Delta (signed dB)"
	range -128 127
	default 0
	help
	  Transmit power delta, in signed dB, to indicate the recommended difference
	  between the remote device's power level for the CS tones and RTT packets
	  and the existing power level for the PHY indicated by the PHY parameter.
	  Value 0x80 (-128) indicates that the host does not have a recommendation
	  for transmit power delta.

config TX_PHY_CS_REF
	bool "Use current TX PHY as CS reference TX power PHY"
	depends on BT_USER_PHY_UPDATE
	default y
	help
	  Enable to use the current TX PHY as the reference PHY for CS transmit power.
	  When enabled, the CS procedure will use the same PHY settings as the current
	  TX PHY for power reference calculations.

config READ_RSSI
	bool "Read RSSI after CS procedure"

config ATM_BT_PHY_UPDATE
	bool "Enable PHY Update"
	depends on BT_USER_PHY_UPDATE
	help
	  Enable automatic PHY update to the configured mode if a different PHY is detected
	  during connection. When enabled, the system will attempt to update the PHY to the
	  mode specified by CONFIG_ATM_BT_PHY.

config ATM_BT_PHY
	int "Preferred PHY Mode"
	depends on ATM_BT_PHY_UPDATE
	range 0 2
	default 1
	help
	  Select the preferred PHY mode for automatic PHY updates:
	  0: 1M PHY - Enhanced range and signal penetration
	  1: 2M PHY - Higher data rate for improved throughput
	  2: Coded PHY - Extended range with lower data rate

config ATM_CS_QUICK_TEST
	bool "CS interval with 180ms with two sub-events"

config RREQ_SET_RAS_FILTER
	bool "Set RAS Mode 2 ranging data filter"
	help
	  When enabled, after subscribing to the RAS Control Point and
	  before subscribing to ranging data, the initiator sends a
	  Set Filter CP command with Mode 2 and the mask value
	  configured by RREQ_RAS_FILTER_MODE_2_MASK to filter out the
	  selected Mode 2 fields from ranging data reported by the
	  server.

config RREQ_RAS_FILTER_MODE_2_MASK
	hex "Mode 2 filter mask value for Set Filter CP command"
	depends on RREQ_SET_RAS_FILTER
	range 0x0000 0x3FFF
	default 0x3FF8
	help
	  14-bit filter mask value sent with the Set Filter CP command
	  for Mode 2. A set bit keeps the corresponding field in the
	  ranging data; a cleared bit filters it out.

	  Mode 2 mask bits:
	    bit 0   : Antenna Permutation Index
	    bit 1   : Phase Correction Term
	    bit 2   : Quality Indicator and Extension Indicator
	    bit 3-6 : Antenna Path 1~3 unsupported indication

	  The default 0x3FF8 clears all step data for mode2

config ENABLE_CS_REF_IPT
	bool "Enable CS reflector inline PCT"
	select BT_LE_EXTENDED_FEAT_SET
	select ATM_ENA_LL_FEAT_CS_ENH1

config FORCE_DISABLE_IPT
	bool "Support IPT but disable IPT for CS config"
	depends on ENABLE_CS_REF_IPT

config RREQ_DISABLE_RD_SUB
	bool "Disable ranging data subscriptions"
	help
	  When enabled, the initiator skips all ranging data
	  subscriptions in the RREQ_SMF_RAS_SUBSCRIBE state. This
	  covers both the real-time ranging data subscription (when
	  RAS_CLIENT_REAL_TIME_RD is enabled) and the on-demand
	  ranging data subscriptions (ranging data overwritten,
	  ranging data ready, and on-demand ranging data). Only the
	  RAS Control Point subscription is kept.

config RREQ_IQ_DUMP
	bool "Stream the raw CS IQ records over the console UART"
	default y
	help
	  On by default: Stream the raw CS IQ records over the console UART.

config RREQ_USE_ARIAD
	bool "Link the Ariad distance estimator (openair/lib/ariad)"
	select ATM_ARIAD_LIB
	help
	  Links the prebuilt libariad.a from openair/lib/ariad and enables the
	  estimator-backed CS distance path (cs_distance.c). Exercised by the
	  applications.ras_rreq_initiator.atm.ariad test configuration.

config RREQ_USE_DISPLAY
	bool "Show the CS distance on a GME OLED"
	depends on RREQ_USE_ARIAD
	select I2C
	select DISPLAY
	select CHARACTER_FRAMEBUFFER
	help
	  Enables cs_display.c, which mirrors the smoothed CS distance from the
	  Ariad estimator to a GME I2C OLED (the oled_display node in
	  oled.overlay) through the character framebuffer. Separate from
	  RREQ_USE_ARIAD; prj.conf sets it n by default so boards without the OLED
	  module still build the estimator path cleanly. Set
	  CONFIG_RREQ_USE_DISPLAY=y in prj.conf (or a board overlay) on a board
	  that carries the OLED, and pass oled.overlay so the node exists.

module = RREQ
module-str = RREQ
source "subsys/logging/Kconfig.template.log_config"

module = RREQ_SMF
