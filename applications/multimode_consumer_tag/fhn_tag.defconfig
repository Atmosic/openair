# ==============================================================================
# Fast Pair Credentials (Google Nearby Console)
# ------------------------------------------------------------------------------
# Google Fast Pair requires a unique 24-bit Model ID and Anti-Spoofing Key
# generated per hardware platform / product profile via the Google Nearby Console.
#
# These credentials bind the underlying chipset to the registered product profile
# (which controls UI assets, device pop-up icons, companion app routing, and FHN
# network integration on Android).
#
# - SOC_SERIES_ATM33: Uses platform-specific credentials registered for ATM33
#   chipset builds.
# - Default: Fallback credentials for generic/reference targets.
#
# Ref: https://developers.google.com/nearby/fast-pair/specifications/introduction
# ==============================================================================

configdefault FAST_PAIR_MODEL_ID
    default 0x1A7331 if SOC_SERIES_ATM33
    default 0x8FE397

configdefault FAST_PAIR_AS_KEY
    default "wLhpDl6Z4da3v/s1/AA32ZUtvMUkgtmPTCy5weMIDrs=" if SOC_SERIES_ATM33
    default "3H/wrAa6A5Bn2IvSq0E6RrNMucXdhEtI/Vv4sKiHtoI="
