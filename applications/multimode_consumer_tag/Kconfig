module = MULTIMODE_CONSUMER_TAG
module-str = multimode_consumer_tag
source "subsys/logging/Kconfig.template.log_config"

config FMNA_TAG
	bool "Enable FMNA Tag"
	select ATM_FMNA
	default y

config FHN_TAG
	bool "Enable FHN Tag"
	select ATM_GFP
	select ATM_GFP_MUTLIMODE_TAG if FMNA_TAG || STF_TAG
	imply FAST_PAIR_AUTH_CB_GLOBAL if !FMNA_TAG && !STF_TAG
	default y

config STF_TAG
	bool "Enable STF Tag"
	select ATM_STF
	default y

config FMNA_DEV_CUSTOM_BT_ADDR
	bool "Enable custom Bluetooth device address for testing or development purposes"

config FMNA_DEV_CUSTOM_BT_ADDR_VALUE
	string "Custom Bluetooth address (MAC format: XX:XX:XX:XX:XX:XX)"
	depends on FMNA_DEV_CUSTOM_BT_ADDR
	default "ED:15:48:87:6E:EF"

config FMNA_PRODUCT_DATA
	string "FMNA Product Data"
	default "DFECEFF1E1FF54DB"

config FMNA_ACCESSORY_CATEGORY
	int "FMNA Accessory Category"
	range 0 255
	default 129

config FMNA_ACCESSORY_CAPABILITY
	int "FMNA Accessory Capability Bit Mask"
	range 0 65535
	default 31
	help
	  Bit 0: Supports play sound
	  Bit 1: Supports motion detector UT
	  Bit 2: Supports serial number lookup by NFC
	  Bit 3: Supports serial number lookup by BLE
	  Bit 4: Supports firmware update service

config FMNA_BATTERY_TYPE
	int "FMNA Battery Type"
	range 0 255
	default 1
	help
	  0: Powered
	  1: Non-rechargeable battery
	  2: Rechargeable battery

config FMNA_PID
	int "FMNA Product ID"
	range 0 65535
	default 51966

config FMNA_MANUFACTURER_NAME
	string "FMNA Manufacturer Name"
	default "Osprey"

config FMNA_MODEL_NAME
	string "FMNA Model Name"
	default "Bike"

config FMNA_HARDWARE_VERSION
	string "FMNA Hardware Version"
	default "1"

config FMNA_VERSION_MAJOR
	int "FMNA Version Major"
	range 0 65535
	default 1

config FMNA_VERSION_MINOR
	int "FMNA Version Minor"
	range 0 65535
	default 0

config FMNA_VERSION_REVISION
	int "FMNA Version Revision"
	range 0 65535
	default 18

if FHN_TAG

config FHN_FW_VERSION
	string "FP Tag Firmware Version"
	default "1.0.0"
	help
	  Firmware version string for FHN tag. This version is returned by the
	  fp_tag_get_fw_version() function and used in FP tag operations.
	  The maximum length is (CONFIG_GFP_DIS_FW_VERSION_STR_MAX - 1).

config FHN_MOTION_DETECT_SUPPORT
	bool
	default y if !TAG_MOTION_SENSOR_TYPE_NONE || AT_CMD_TAGMOTIONRPT
	select DULT_MOTION_DETECT
	select DULT_MOTION_DETECT_TRIGGER if AT_CMD_TAGMOTIONRPT || (TAG_MOTION_SENSOR_TYPE_LIS2DH && LIS2DH_TRIGGER)
	select FMDN_OOB_MOTION_DETECT_TRIGGER if CONFIG_FMDN_PRECISION_FINDING && (AT_CMD_TAGMOTIONRPT || (TAG_MOTION_SENSOR_TYPE_LIS2DH && LIS2DH_TRIGGER))

endif # FHN_TAG

config TAG_BUTTON
	bool "Enable physical button control"
	default y

config TAG_BTN_POWER_CTRL
	bool "Enable button power on/off control"
	depends on TAG_BUTTON
	select PM
	help
	  Enable button control for power on/off functionality.
	  2s press to power on/off with LED indication.

config TAG_BTN_FACTORY_RESET
	bool "Enable factory reset with long press button"
	depends on TAG_BUTTON
	help
	  Long press button for 10 secs to trigger factory reset in power on
	  state. Pressing 2 secs would trigger power off key first and keep
	  pressing until 10 secs would trigger factory reset then enter off state.

config TAG_BTN_BATT_REPORT
	bool "Enable battery level detection with button"
	depends on TAG_BUTTON
	help
	  Quick press button 5 times to show battery level with LED indication.

config TAG_OTA_MODE
	bool "Enable OTA mode"
	default y if BOOTLOADER_MCUBOOT && MCUMGR_TRANSPORT_BT
	help
	  Enable OTA firmware update mode. Enables platform_ctrl_ota and
	  allows entry via button tap or long press.

config TAG_BTN_OTA_TAP_CNT
	int "Number of taps to enter OTA mode (0 to disable)"
	depends on TAG_OTA_MODE
	default 10
	range 0 20
	help
	  Quick press button this many times to enter OTA mode.
	  Set to 0 to disable tap entry.

config TAG_BTN_OTA_LONG_PRESS_MS
	int "Button hold duration to enter OTA mode in ms (0 to disable)"
	depends on TAG_OTA_MODE
	default 0 if TAG_BTN_FACTORY_RESET
	default 7000
	range 0 60000
	help
	  Hold the button for this many milliseconds to enter OTA mode.
	  Set to 0 to disable long press entry.

config TAG_BTN_OTA_BOOT_WINDOW_MS
	int "Boot window for OTA mode entry in ms (0 to disable)"
	depends on TAG_OTA_MODE
	default 0
	range 0 3600000
	help
	  OTA mode can only be entered within this many milliseconds of booting.
	  After the window expires, tap and long-press will no longer trigger OTA
	  mode entry. Set to 0 to allow entry at any time.

config TAG_OTA_TIMEOUT_MS
	int "OTA mode inactivity timeout in ms (0 to disable)"
	depends on TAG_OTA_MODE
	default 0
	range 0 3600000
	help
	  Timeout in ms before the device reboots back to normal mode if no
	  DFU transfer completes. Set to 0 to disable the timeout.

config TAG_OTA_DEVICE_NAME
	string "OTA mode BLE device name"
	depends on TAG_OTA_MODE
	default "Atmosic OTA"
	help
	  BLE device name advertised when the device is in OTA mode.

config TAG_BTN_FMNA_SN_LOOKUP
	bool "Enable FMNA SN lookup with button short press 6 times"
	depends on TAG_BUTTON && FMNA_TAG
	default y
	help
	  Quick press button 6 times to enable the FMNA paired-owner serial
	  number (SN) readout. Required by Apple FindMy certification test #8:
	  the encrypted SN payload is non-readable in normal state and only
	  becomes readable for 5 minutes after this user action. After the
	  5 minute window the SN is automatically gated again with no further
	  user action.

config TAG_BTN_LOG_FMNA_MFI_TOKEN
	bool "Log MFI token with button short press 8 times"
	depends on TAG_BUTTON && FMNA_TAG
	default y
	help
	  Log MFI token with button short press 8 times.

config TAG_LED_IND
	bool "Enable LED indication for state and button"
	select LED
	help
	  Power on: Green LED blinks 3 times
	  Power off: Red LED blinks 3 times
	  Pairing mode: Green blink -> Red blink every 5 secs
	  Operation mode: Green LED blinks every 20 secs
	  Battery Status:
	    >90% 5 GREEN blinks
	    >60% 4 GREEN blinks
	    >30% 3 GREEN blinks
	    >10% 2 GREEN blinks
	    <=10% single GREEN blink

config TAG_SOC_OFF_TIMEOUT
	int "SOC off timeout in pairing mode (seconds)"
	range 0 300
	default 180
	help
	  Timeout in seconds to enter SOC_off mode when in pairing mode.
	  Set to 0 to disable timeout.

config TAG_BUZZER
	bool "Enable buzzer hardware support"
	default $(dt_nodelabel_enabled,pwm_buzzer0)

config TAG_AUDIO_FEEDBACK
	bool "Enable audio feedback for factory reset"
	select ATM_BUZZER
	depends on TAG_BUZZER
	help
	  Enable audio feedback when factory reset is triggered.

choice TAG_MOTION_SENSOR_TYPE
	prompt "Motion detection type"
	default TAG_MOTION_SENSOR_TYPE_LIS2DH if DT_HAS_ST_LIS2DH_ENABLED
	default TAG_MOTION_SENSOR_TYPE_NONE

config TAG_MOTION_SENSOR_TYPE_LIS2DH
	bool "LIS2DH motion sensor"
	select LIS2DH
	select SENSOR

config TAG_MOTION_SENSOR_TYPE_NONE
	bool "No motion detection"

endchoice

config ATM_LL_HEAP_SIZE
	int "Override LL heap size"
	default 41396 if ATM_LCROM_IFACE && ATMWSTK_PD50
	default 36364 if ATM_ENA_LL_FEAT_CS && ATMWSTK_PD50
	default 61396 if ATM_LCROM_IFACE && ATMWSTK_CPD200
	default 81396 if ATM_LCROM_IFACE
	default 28656

config APP_WORK_Q_STACK_SIZE
	int "Application work queue stack size"
	default 4096

config MCUMGR_MGMT_NOTIFICATION_HOOKS
	bool "Enable MCUmgr notification hooks"
	default y if MCUMGR_TRANSPORT_UART

config MCUMGR_GRP_IMG_STATUS_HOOKS
	bool "Enable MCUmgr image status hooks"
	default y if MCUMGR_TRANSPORT_UART

source "Kconfig.zephyr"
