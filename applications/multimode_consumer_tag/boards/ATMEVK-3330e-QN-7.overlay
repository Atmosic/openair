#include "../app.overlay"

&arduino_i2c {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	lis2dh12: lis2dh12@19 {
		compatible = "st,lis2dh12", "st,lis2dh";
		reg = <0x19>;
		label = "LIS2DH12";
	};
};

/ {
	chosen {
		atm,motion-sensor = &lis2dh12;
	};
};
