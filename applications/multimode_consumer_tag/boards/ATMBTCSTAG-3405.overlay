/ {
	zephyr,user {
		io-channels = <&adc 1>;
	};
	aliases {
		tag-pwm = &pwm_buzzer0;
	};
};

&wdog0 {
	status = "okay";
};

&soc_off {
	status = "okay";
};

&cpu0 {
	cpu-power-states = <&idle &sleep &retain &hibernate &soc_off>;
};

&arduino_i2c {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	lis2dh12: lis2dh12@19 {
		compatible = "st,lis2dh12", "st,lis2dh";
		reg = <0x19>;
		label = "LIS2DH12";
	};
};
