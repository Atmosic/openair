menuconfig ATM_FMDN
    bool "Find My Device Network extension of Google Fast Pair (FMDN)"
    depends on FAST_PAIR_FMDN
    help
        "Find My Device Network extension (FMDN)"

if ATM_FMDN

config HEAP_MEM_POOL_ADD_SIZE_ATM_FMDN
	int "Heap memory pool size for FMDN extension"
	default 128
	help
	  Additional heap memory pool size required by Find My Device Network extension.
	  This includes work items for provisioning, ring notifications, and CS settings.

choice FMDN_ECC_TYPE
    prompt "Elliptic Curve selection"
    default FMDN_ECC_SECP160R1
    help
	Select the encryption of Elliptic Curve to be used.

config FMDN_ECC_SECP160R1
    bool "FMDN with the SECP160R1 Elliptic Curve"
    depends on ATM_GFP_DIRECT_UECC_INTERFACE
    help
	Select the SECP160R1 Elliptic Curve for FMDN. This curve type is less
	secure than the SECP256R1 variant, but it can be used with Bluetooth
	Legacy Advertising because of its limited size (160 bits).

config FMDN_ECC_SECP256R1
    bool "FMDN with the SECP256R1 Elliptic Curve"
    help
	Select the SECP256R1 Elliptic Curve for FMDN. This curve type is more
	secure than the SECP160R1 variant but requires using Bluetooth Extended
	Advertising due to its extended size (256 bits).

endchoice

config FMDN_HASH_FLAGS
    bool "Advertising data with hash flags"
    default y

config FMDN_MAX_CONN
    int "FMDN maximum concurrent connected client"
    default 2

choice FMDN_RING_COMP
    prompt "Ringing component selection"
    default FMDN_RING_COMP_NONE
    help
	Select the number of components capable of ringing.

config FMDN_RING_COMP_NONE
    bool "No component capable of ringing"

config FMDN_RING_COMP_ONE
    bool "Single component capable of ringing"

config FMDN_RING_COMP_TWO
    bool "Two components (left and right buds) capable of ringing"

config FMDN_RING_COMP_THREE
    bool "Three components (left and right buds and case) capable of ringing"

endchoice

# Power-loss recovery advertising

config FMDN_CLOCK_SAVE_INTERVAL_SEC
    int "Periodic FMDN clock save interval (seconds)"
    default 86400
    help
	Periodic FMDN clock save interval (seconds)
	FMDN spec: at least once per day (86400s).

config FMDN_POWER_LOSS_RECOVERY_TIMEOUT_SEC
    int "Continuous advertising timeout (seconds)"
    default 300
    help
	Continuous advertising duration after power loss before switching to periodic mode.
	FMDN spec: 5 minutes.

config FMDN_POWER_LOSS_PERIODIC_INTERVAL_SEC
    int "Periodic cycle interval (seconds)"
    default 600
    help
	Gap between periodic advertising cycles (end of one to start of next).
	FMDN spec: at least every 10 minutes (max 600s gap).

config FMDN_POWER_LOSS_PERIODIC_DURATION_SEC
    int "Periodic cycle duration (seconds)"
    default 30
    help
	Duration of each periodic advertising cycle.
	FMDN spec: at least 30 seconds.

config FMDN_POWER_LOSS_PERIODIC_ADV_INTERVAL_MS
    int "Periodic BLE advertising interval (milliseconds)"
    default 1000
    help
	BLE advertising packet interval during periodic cycles.
	FMDN spec: 1 second.

config FMDN_PERSISTENT_CONNECTION
    bool "Enable Persistent Connection support"
    depends on FAST_PAIR_FMDN_V2
    default y
    help
	Enable Persistent Connection feature for FHN v2.
	Persistent Connection allows longer connection intervals to save power,
	with acceptable latency for Find/Ring/Reverse Ringing operations.
	This feature is reported in the capabilities bitmap (bit 0).

config FMDN_REVERSE_RINGING
    bool "Enable Reverse Ringing support"
    depends on FAST_PAIR_FMDN_V2
    default y
    help
	Enable Reverse Ringing feature for FHN v2.
	Reverse Ringing allows the Provider to ring the Seeker device.
	This feature is reported in the capabilities bitmap (bit 1).

config FMDN_REVERSE_RINGING_ADV_TIMEOUT_SEC
    int "Reverse Ringing Advertising timeout (seconds)"
    default 20
    range 15 20
    depends on FMDN_REVERSE_RINGING
    help
	Reverse Ringing Advertising timeout duration.
	FHN v2 spec: 15-20 seconds.

config FMDN_V2_MINIMAL_LOGGING
    bool "Minimal logging for FHN v2 (production builds)"
    depends on FAST_PAIR_FMDN_V2
    default n
    help
      Reduce logging in FHN v2 modules to only errors and warnings.
      This saves 3-10KB of flash by removing informational and debug logs.

      When enabled:
      - LOG_ERR and LOG_WRN are kept (critical for debugging)
      - LOG_INF and LOG_DBG are compiled out at build time

      Recommended for production builds with flash constraints.

      Flash savings breakdown:
      - Reverse Ringing: ~1.5-4KB
      - Advertisement Ringing: ~0.9-2.5KB
      - Persistent Connection: ~1.0-2.8KB
      - Secure Beacon Actions: ~0.9-2.5KB
      Total: ~4-12KB flash savings

# FMDN Logging Level Configuration
# This controls the compile-time log level for all FMDN modules
config ATM_FMDN_LOG_LEVEL
    int
    default 2 if FMDN_V2_MINIMAL_LOGGING  # WRN level (errors + warnings only)
    default 3                              # INF level (default: errors + warnings + info)
    help
      Maximum compiled-in log level for FMDN modules.

      Levels:
      - 0: OFF (no logging)
      - 1: ERR (errors only)
      - 2: WRN (errors + warnings)
      - 3: INF (errors + warnings + info) [DEFAULT]
      - 4: DBG (all logs including debug)

      This value is used by LOG_MODULE_DECLARE(fmdn, CONFIG_ATM_FMDN_LOG_LEVEL)
      in all FMDN source files. Logs above this level are compiled out.

# Include precision finding (FHPF) configuration
rsource "Kconfig.fhpf"

endif #  ATM_FMDN
