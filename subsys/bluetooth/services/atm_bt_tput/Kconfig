config ATM_BT_TPUTP
	bool "Support for BLE throughput service"

config ATM_TPUT_TEST_DATA_LEN_PER_PACKET
	int "Data length per packet in ble throughput test"
	default 243

config ATM_TPUT_TEST_PACKET_COUNT
	int "Numer of packets in ble throughput test"
	default 1000

config ATM_TPUT_AUTO_TEST
	bool "Enable auto test for ble throughput test"
	default y if ZTEST
	help
	  Enable automatic test mode for BLE throughput testing.
	  Central device automatically sends end test command to peripheral
	  after completing the test, allowing both devices to coordinate
	  test completion without manual intervention.

if ATM_BT_TPUTP

module = ATM_BT_TPUTP
module-str = ATM_BT_TPUTP
source "subsys/logging/Kconfig.template.log_config"

endif # ATM_BT_TPUTP
