menuconfig ATM_DULT
    bool "Detecting Unwanted Location Trackers (DULT)"
    depends on BT
    select APP_WORK_Q
    help
	"Detecting Unwanted Location Trackers (DULT) Service"
	See https://www.ietf.org/archive/id/draft-detecting-unwanted-location-trackers-01.html#name-applicability.

if ATM_DULT

config HEAP_MEM_POOL_ADD_SIZE_ATM_DULT
	int "Heap memory pool size for DULT service"
	default 256
	help
	  Additional heap memory pool size required by DULT Service.
	  Covers GATT response buffers and GATT-initiated sound indication
	  work items.  Motion detection (CONFIG_DULT_MOTION_DETECT) does not
	  add heap usage — its work items are statically allocated in BSS.

module = ATM_DULT
module-str = dult
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

config DULT_MANUFACTURER_NAME
    string "Manufacturer name"
    default "Atmosic Tech."
    help
	The name should match the value provided in the Google Nearby Console.

config DULT_MODEL_NAME
    string "Model name"
    default "Google Fast Pair"
    help
	The name should match the value provided in the Google Nearby Console.

config DULT_ACCESSORY_CATEGORY_TYPE
    int "The category value from DULT specification the accessory most closely resembles"
    range 1 167
    default 1 # NO_ACC_CAT_LOC_TRACKER
    help
	See https://www.ietf.org/archive/id/draft-detecting-unwanted-location-trackers-01.html#name-accessory-category-value for specific category value.

config DULT_FIRMWARE_VERSION_MAJOR
    int "DULT Firmware major version"
    default 1
    range 0 65535
    help
	Default is set to 1, because Major.Minor.Revision value of 0.0.0 is not
        supported by the Fast Pair Validator Android app.

config DULT_FIRMWARE_VERSION_MINOR
    int "DULT Firmware major version"
    default 0
    range 0 255

config DULT_FIRMWARE_VERSION_REVISION
    int "DULT Firmware revision version"
    default 0
    range 0 255

config DULT_PROTOCOL_IMPLEMENTATION_VERSION
    hex "DULT implementation version"
    default 0x00010000

config DULT_MOTION_DETECT
	bool "DULT motion detector UT support"
	help
	  Enable motion detector Unwanted Tracker (UT) behavior defined in
	  the DULT specification. Requires a motion detector (e.g. accelerometer)
	  capable of detecting an orientation change of +-10 degrees along any
	  two axes of the accessory.

config DULT_MOTION_DETECT_TRIGGER
	bool "Enable trigger-based motion detection for DULT UT"
	depends on DULT_MOTION_DETECT
	help
	  Enable interrupt-driven (trigger) motion event path for DULT UT.
	  When selected, the platform signals motion via dult_ut_motion_event()
	  on each hardware interrupt instead of using the polling loop.  Only the
	  polling infrastructure (poll handler and periodic poll work) is excluded
	  from the build; the 20s fast-phase backoff timer remains active in both
	  modes.

config DULT_MOTION_DETECT_SOUND_DURATION_MS
	int "DULT motion detect sound duration in milliseconds"
	default 500
	range 1 65535
	depends on DULT_MOTION_DETECT
	help
	  The duration of the sound played when motion is detected.

config DULT_ACCESSORY_CAPABILITIES
    hex "The capability value from DULT specification the accessory most closely resembles"
    default 0xB if DULT_MOTION_DETECT  # play sound + motion detector UT + BLE lookup
    default 0x9                        # play sound + BLE lookup (no motion detector)
    help
	See https://www.ietf.org/archive/id/draft-detecting-unwanted-location-trackers-01.html#name-accessory-category-value for specific category value.

config DULT_NETWORK_ID
    hex "DULT NETWORK ID"
    default 0x2 # google network id

config DULT_BATTERY_TYPE
    hex "DULT battery type"
    default 0x2 # Rechargeable battery
    help
	See https://www.ietf.org/archive/id/draft-detecting-unwanted-location-trackers-01.html#name-accessory-category-value for specific category value.

config DULT_NETWORK_VERSION_MAJOR
    int "DULT Network major version"
    default 1
    range 0 65535
    help
	Default is set to 1

config DULT_NETWORK_VERSION_MINOR
    int "DULT Network major version"
    default 0
    range 0 255

config DULT_NETWORK_VERSION_REVISION
    int "DULT Network revision version"
    default 0
    range 0 255

config DULT_ADV_SUPPORT
    bool "DULT advertising support"
    help
	Enable DULT advertising support.

config DULT_SEPARATION_DETECT
	bool "DULT owner-disconnection separation detection"
	default n
	help
	  Enable the legacy 30-minute owner-disconnection timer that changes the
	  DULT mode to separated. When disabled, applications such as FMDN can
	  control the separated mode state through their own protocol.

endif # ATM_DULT
