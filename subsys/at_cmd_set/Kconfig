config AT_EVT_BLEGATTFROMBLE
	bool "BLE GATT data from client event"
	default y if AT_CMD_PERIPHERAL
	select AT_CMD_SET_EVENTS
	select AT_CMD_SET_CONN_TRACKING
	help
	  Report +EVTBLEGATTFROMBLE event when a client writes data
	  to a characteristic. Can be used independently or with the
	  default GATT server.

config AT_EVT_BLESMPPASSKEY
	bool "Enable BLE SMP passkey display event"
	default y if AT_CMD_BLESMPPAIRREQ
	select AT_CMD_SET_EVENTS
	depends on AT_CMD_SET_SMP_AUTH
	help
	  Emits an event when the stack requests the passkey be
	  displayed to the user (passkey_display callback).

config AT_EVT_BLESMPPASSKEYREQIND
	bool "Enable BLE SMP passkey entry indication"
	default y if AT_CMD_BLESMPPAIRREQ
	select AT_CMD_SET_EVENTS
	depends on AT_CMD_SET_SMP_AUTH
	help
	  Emits an indication when the stack requires the user to enter the
	  passkey displayed on the peer device. The host must respond with
	  the passkey entry command to unblock the SMP state machine.

config AT_EVT_BLESMPNUMCOMPIND
	bool "Enable BLE SMP numeric comparison indication"
	default y if AT_CMD_BLESMPPAIRREQ
	select AT_CMD_SET_EVENTS
	depends on AT_CMD_SET_SMP_AUTH
	help
	  Emits an indication when the stack requires the user to confirm that
	  the displayed number matches the peer. The host must respond with
	  the numeric comparison confirm command to unblock the SMP state machine.

config AT_EVT_BLESMPPAIRENDIND
	bool "Enable BLE SMP pairing end indication"
	default y if AT_CMD_BLESMPPAIRREQ
	select AT_CMD_SET_EVENTS
	depends on AT_CMD_SET_SMP_AUTH
	help
	  Emits an indication on pairing completion (bonded=0/1, err=0) or
	  failure (err=bt_security_err code).

config AT_CMD_TAG_SET_EVENTS
	bool "Tag AT events"
	depends on STF_TAG || FMNA_TAG || FHN_TAG || ATM_AT_CMDTEST
	select AT_CMD_SET_EVENTS
	help
	  Register tag-related AT event handlers.

config AT_CMD_TAG_SET
	bool "Tag AT commands"
	depends on STF_TAG || FMNA_TAG || FHN_TAG || ATM_AT_CMDTEST
	select AT_CMD_SET_CALLBACKS
	select AT_CMD_TAG_SET_EVENTS
	select AT_CMD_SYSDFU if BOOTLOADER_MCUBOOT
	help
	  Enable tag related AT commands.
	  When used with MCUboot, AT+SYSDFU command is automatically enabled for
	  serial firmware updates over the AT command UART.

