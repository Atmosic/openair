	bool "AT+TAGRESET: factory reset"
	default y

config AT_CMD_TAGSTFIND
	bool "AT+TAGSTFIND=<1>: simulate STF button press (stop ring or confirm pairing)"
	depends on STF_TAG || ATM_AT_CMDTEST
	default y if STF_TAG || ATM_AT_CMDTEST
	help
	  Required when CONFIG_TAG_BUTTON=n.
	  Single press behavior: stops active ring if playing; otherwise confirms pairing.

config AT_CMD_TAGFMNASN
	bool "AT+TAGFMNASN=1: trigger FMNA SN lookup window"
	depends on FMNA_TAG || ATM_AT_CMDTEST
	default y

