	  Valid range is 1000–3000 ms.

config AT_CMD_BLEGAPCREATECONN
	bool "Enable BLE central create-connection"
	default y if AT_CMD_CENTRAL
	depends on AT_CMD_BLESCANENABLE
	select AT_CMD_BLEGAPCANCELCREATECONN
	select AT_CMD_SET_CONN_TRACKING
	imply AT_CMD_BLEGAPDISCONNECT

config AT_CMD_BLEGAPCANCELCREATECONN
	bool "Enable cancellation of a pending BLE central connection initiation"
	depends on AT_CMD_BLEGAPCREATECONN
	select AT_CMD_SET_CONN_TRACKING
	help
	  Calls bt_conn_le_create_cancel() and rejects the command with
	  AT_ERR_BLE_EINVAL when no connection creation is in progress.

config AT_CMD_BLEGAPDEVNAME
	bool "BLE GAP device name set/query"
	default y if AT_CMD_PERIPHERAL
	select BT_DEVICE_NAME_DYNAMIC
	help
	  Calls bt_set_name() to set and bt_get_name() to read the Bluetooth
	  GAP device name. Maximum name length is CONFIG_BT_DEVICE_NAME_MAX
	  bytes. The advertising data is not refreshed automatically; restart
	  advertising (or update adv/scan-response data) to expose the new
	  name to scanners. When CONFIG_BT_SETTINGS is enabled the name is
	  persisted across reboots.

config AT_CMD_BLEGAPDISCONNECT
	bool "Enable BLE disconnect"
	default y if AT_CMD_CENTRAL || AT_CMD_PERIPHERAL
	select AT_CMD_SET_CONN_TRACKING
	help
	  Works for both central and peripheral roles. Cancels a pending connection
	  initiation or disconnects an established connection by connection index.

config AT_CMD_BLEGAPGETCONNSTAT
	bool "Enable BLE connection status query"
	default y if AT_CMD_CENTRAL || AT_CMD_PERIPHERAL
	select AT_CMD_SET_CONN_TRACKING
	help
	  Returns role, peer address, connection interval, latency and supervision
	  timeout for a tracked connection slot.

config AT_CMD_BLECONNTXPWR
	bool "Enable BLE connection TX power setting"
	default y if AT_CMD_CENTRAL || AT_CMD_PERIPHERAL
	imply ATM_VENDOR_API
	imply VND_API_SET_CON_TX_POWER
	select AT_CMD_SET_CONN_TRACKING
	help
	  Sets the transmit
	  power for a specific active connection slot using the Atmosic vendor API
	  (CONFIG_VND_API_SET_CON_TX_POWER). Supported dBm values are -20, -10, -8,
	  -6, -4, -2, 0, 2, 4, 6, 8, and 10 dBm; the RF driver selects the closest
	  available level.

config AT_CMD_BLEGAPGETPEERINFO
	bool "Enable BLE peer information query"
	default y if AT_CMD_CENTRAL || AT_CMD_PERIPHERAL
	select AT_CMD_SET_CONN_TRACKING
	help
	  Returns the peer identity address type, peer identity address, security
	  level and encryption key size for a tracked connection slot.

config AT_CMD_BLEGAPGETRSSI
	bool "Enable BLE connection RSSI query"
	default y if AT_CMD_CENTRAL || AT_CMD_PERIPHERAL
	select AT_CMD_SET_CONN_TRACKING
	help
	  Issues an HCI Read RSSI command for the tracked connection slot and
	  returns the received signal strength in dBm as a signed byte.

config AT_CMD_BLEGAPPARNEGO
	bool "Enable BLE connection parameter negotiation"
	default y if AT_CMD_CENTRAL || AT_CMD_PERIPHERAL
	select AT_CMD_SET_CONN_TRACKING
	help
	  Calls bt_conn_le_param_update() to request a BLE connection parameter
	  update for a tracked connection slot. The peer may accept or reject the
	  new interval, latency, and supervision timeout values. Interval values
	  are expressed in 1.25 ms units; the supervision timeout is in 10 ms
	  units. The command returns ERR with AT_ERR_BLE_EINVAL when the
	  connection index is not found, or with the mapped errno when the
	  Zephyr API rejects the request (e.g. EINVAL for out-of-range params).

config AT_CMD_BLEGATTMTUEXCHGREQ
	bool "Enable BLE GATT MTU exchange request"
	default y if AT_CMD_CENTRAL || AT_CMD_PERIPHERAL
	select AT_CMD_SET_CONN_TRACKING
	select BT_GATT_CLIENT
	help
	  Calls bt_gatt_exchange_mtu() on the specified active connection to
	  initiate an ATT MTU exchange with the peer. Can only be issued once
	  per connection (returns AT_ERR_BLE_EALREADY if already performed).
	  The negotiated MTU is reported asynchronously via the
	  +EVTBLEGATTMTUEXCHANGE event when CONFIG_AT_EVT_BLEGATTMTUEXCHANGE
	  is enabled.

config AT_CMD_BLEGATTMTUGET
	bool "Enable BLE GATT MTU query"
	default y if AT_CMD_CENTRAL || AT_CMD_PERIPHERAL
	select AT_CMD_SET_CONN_TRACKING
	help
	  Returns the current unenhanced ATT (UATT) MTU for the specified
	  active connection slot by calling bt_gatt_get_uatt_mtu(). The MTU
	  reflects the value negotiated during the ATT MTU exchange procedure.

config AT_CMD_SET_CONN_TRACKING
	bool
	help
	  Automatically enabled when any command that requires the connection
	  tracking array (conns[], conn_count) is selected.

config AT_CMD_BLESMPPAIRREQ
	bool "Enable BLE SMP pair request"
	default y if AT_CMD_CENTRAL || AT_CMD_PERIPHERAL
	select BT_SMP
	select BT_BONDABLE_PER_CONNECTION
	select AT_CMD_SET_CONN_TRACKING
	select AT_CMD_SET_SMP_AUTH
	help
	  Initiates BLE SMP pairing with configurable IO capability, OOB flag,
	  bond flag and security level. Calls bt_conn_auth_cb_overlay() to
	  install per-connection authentication callbacks, bt_conn_set_bondable()
	  to control the SMP bonding bit per-connection, and bt_conn_set_security()
	  to start the pairing procedure.

config AT_CMD_BLESMPPASSKEY
	bool "Enable BLE SMP passkey entry response"
	default y if AT_CMD_BLESMPPAIRREQ
	select AT_CMD_SET_CONN_TRACKING
	help
	  Reply to a passkey entry indication by entering the passkey shown on
	  the peer device. Calls bt_conn_auth_passkey_entry().

config AT_CMD_BLESMPCONFIRM
	bool "Enable BLE SMP numeric comparison confirm"
	default y if AT_CMD_BLESMPPAIRREQ
	select AT_CMD_SET_CONN_TRACKING
	help
	  Reply to a numeric comparison indication by confirming (accept=1) or
	  rejecting (accept=0) the displayed number. Calls
	  bt_conn_auth_passkey_confirm() or bt_conn_auth_cancel().

