menuconfig AT_CMD_SET
	bool "Atmosic AT Command Set"
	depends on ATM_AT_CMD
	depends on BT
	help
	  Enable Atmosic AT Command Set library which provides
	  BLE-related AT commands using Zephyr BLE APIs.

if AT_CMD_SET

module = AT_CMD_SET
module-str = AT Command Set
source "subsys/logging/Kconfig.template.log_config"

config AT_CMD_SET_CALLBACKS
	bool "AT Command Set callback registration"
	default y
	help
	  Enable callback registration support for AT command set features
	  that require application-provided handlers. This allows commands to
	  register and invoke callbacks for extended functionality.

config AT_CMD_SET_EVENTS
	bool "AT Command Set event system"
	default y
	select APP_WORK_Q
	help
	  Enable event system with shared app work queue for asynchronous event
	  processing. Multiple event handlers can use the same work queue for
	  handling AT command-triggered events.
	  Automatically selects APP_WORK_Q.

config ATM_AT_CMDTEST
	bool "Atmosic AT command test commands"
	select AT_EVT_CB_TEST
	help
	  Enable AT command test suite including TESTCMD (basic test),
	  TESTEVENT (event system test), and TESTCBEVT (callback and event test).

config AT_EVT_CB_TEST
	bool "AT event and callback test"
	select AT_CMD_SET_EVENTS
	select AT_CMD_SET_CALLBACKS
	help
	  Enable TESTEVENT and TESTCBEVT test commands for demonstrating
	  the event system and callback registration framework.

if AT_CMD_SET_EVENTS

config AT_CMD_EVT_DATA_MAX_LEN
	int "Maximum event data length"
	range 1 AT_CMD_RESP_LEN
	default 249 if AT_CMD_GATT_CLIENT
	default 64
	help
	  Maximum size of event data that can be passed to event handlers.
	  When AT_CMD_GATT_CLIENT is enabled the minimum required size is
	  5 + AT_CMD_GATT_CLIENT_RD_MAX_LEN (header + payload).

endif # AT_CMD_SET_EVENTS

