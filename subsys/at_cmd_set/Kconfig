config AT_CMD_SYSUARTBR
	bool "System UART baud rate change"
	select UART_USE_RUNTIME_CONFIGURE
	help
	  Change the console UART baud rate at runtime with a configurable
	  deferred-apply delay (in centiseconds). Valid baud rates: 19200, 38400,
	  57600, 115200, 230400, 460800.
	  Automatically selects CONFIG_UART_USE_RUNTIME_CONFIGURE.

config AT_CMD_SYSUARTFC
	bool "System UART flow control change"
	select UART_USE_RUNTIME_CONFIGURE
	help
	  Enable or disable RTS/CTS hardware flow control on the console UART at
	  runtime. action=0 disables flow control, action=1 enables RTS/CTS.
	  Automatically selects CONFIG_UART_USE_RUNTIME_CONFIGURE.

config AT_CMD_SYSUARTRAW
	bool "Transparent UART raw data bridge (BLE GATT)"
	depends on BT_CONN
	select AT_CMD_SET_CONN_TRACKING
	help
	  Bounded single-shot raw data transfer between UART and a connected BLE
	  peer. The att_idx parameter identifies an existing GATT attribute handle
	  in the application's GATT server — no separate service is registered.
	  direction=0 (UART->BLE): the UART ISR feeds bytes via
	  at_cmd_sysuartraw_rx_byte(); exactly <length> bytes are forwarded to the
	  peer via bt_gatt_notify() on the specified attribute handle.
	  direction=1 (BLE->UART): the application GATT write handler calls
	  at_cmd_sysuartraw_rx_ble_data() to forward data to the UART output.
	  The system returns to AT command mode automatically after <length> bytes.
	  Automatically selects AT_CMD_SET_CONN_TRACKING.

config AT_CMD_SYSUARTRAW_BUF_SIZE
	int "UART raw bridge ring buffer size (bytes)"
	depends on AT_CMD_SYSUARTRAW
	range 32 4096
	default 256
	help
	  Size of the ring buffer used to transfer bytes from the UART ISR to
	  the BLE transmission work queue. Larger values reduce the risk of data
	  loss when bursts arrive faster than BLE can drain them.

