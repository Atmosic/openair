	bool "Enable BLE connection parameter update event"
	default y if AT_CMD_CENTRAL || AT_CMD_PERIPHERAL
	select AT_CMD_SET_EVENTS
	depends on AT_CMD_SET_CONN_TRACKING

config AT_EVT_BLEGATTMTUEXCHANGE
	bool "Enable BLE GATT MTU exchange event"
	default y if AT_CMD_CENTRAL || AT_CMD_PERIPHERAL
	select AT_CMD_SET_EVENTS
	depends on AT_CMD_SET_CONN_TRACKING
	help
	  Emits a +EVTBLEGATTMTUEXCHANGE:<conn_idx>,<mtu> unsolicited event
	  whenever the ATT MTU for an active connection is updated. Registers
	  a bt_gatt_cb callback to receive att_mtu_updated notifications from
	  the Zephyr Bluetooth stack. The <mtu> field reflects the TX ATT MTU
	  (the effective maximum payload size for outgoing ATT PDUs).

config AT_EVT_BLEGATTMTUEXCHGREQ
	bool "Enable BLE GATT MTU exchange request result event"
	default y if AT_CMD_BLEGATTMTUEXCHGREQ
	select AT_CMD_SET_EVENTS
	depends on AT_CMD_SET_CONN_TRACKING
	help
	  Emits a +EVTBLEGATTMTUEXCHGREQ:<conn_idx>,<err> unsolicited event
	  when the ATT MTU exchange procedure initiated by AT+BLEGATTMTUEXCHGREQ
	  completes. <err> is 0 on success or an ATT/HCI error code on failure.
	  This event is always emitted (success or failure), enabling the host to
	  detect cases where att_mtu_updated is not called due to an error.

