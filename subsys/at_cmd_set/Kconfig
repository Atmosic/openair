	depends on FMNA_TAG || ATM_AT_CMDTEST
	default y

config AT_CMD_TAGCSUNPAIR
	bool "AT+TAGCSUNPAIR=: unpair Channel Sounding (CS) peer"
	depends on ATM_CS || ATM_AT_CMDTEST
	default y

config AT_CMD_TAGGFPIND
	bool "AT+TAGGFPIND=<1|2>: simulate GFP button press"
	depends on FHN_TAG || FMDN_REVERSE_RINGING || ATM_AT_CMDTEST
	default y
	help
	  Required when CONFIG_TAG_BUTTON=n.
	  Single press (1): Start advertising, stop sound, or stop reverse ringing.
	  Double press (2): Enable DULT window or control reverse ringing.

config AT_CMD_TAGMOTIONRPT
	bool "AT+TAGMOTIONRPT=<x>,<y>,<z>: report motion acceleration from host"
	default y
	select AT_EVT_TAGMOTIONCTL
	help
	  Host reports XYZ acceleration to the tag.
	  x,y,z: acceleration in cm/s² (signed 16-bit).

